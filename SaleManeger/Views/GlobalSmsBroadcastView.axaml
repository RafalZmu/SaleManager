<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SaleManeger.Views.GlobalSmsBroadcastView">

    <Grid>
        <Grid RowDefinitions="Auto, *, Auto" Margin="20">
            <!-- Header -->
            <Border Grid.Row="0" Margin="0,0,0,10" BorderBrush="Gray" BorderThickness="0,0,0,2" Padding="0,0,0,10">
                <Grid ColumnDefinitions="Auto, *">
                    <Button Command="{Binding GoBackCommand}" Content="Cofnij" FontSize="20" Padding="15,5" />
                    <TextBlock Grid.Column="1" Text="Masowa Wysyłka Uniwersalna (Cała Baza)" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Spacing="15" Margin="0,15,0,0">
                <!-- Server Config -->
                <Border BorderBrush="#3D3D40" BorderThickness="1" CornerRadius="5" Padding="15" Background="#1E1E1E">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Konfiguracja Serwera (Capcom6 SMS Gateway)" FontWeight="SemiBold" FontSize="20" />
                        
                        <TextBlock Text="Adres API (Cloud: https://api.sms-gate.app/3rdparty/v1/message | WiFi: http://IP:8080/v1/message)" />
                        <TextBox Text="{Binding ApiUrl}" FontSize="18" />

                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Login (Basic Auth)" />
                                <TextBox Text="{Binding Login}" FontSize="18" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Hasło (Basic Auth)" />
                                <TextBox Text="{Binding Password}" FontSize="18" PasswordChar="*" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Test Message Form -->
                <Border BorderBrush="#3D3D40" BorderThickness="1" CornerRadius="5" Padding="15" Background="#1E1E1E">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Szablon Ogólnosystemowy" FontWeight="SemiBold" FontSize="20" />

                        <TextBlock Foreground="LightGray" TextWrapping="Wrap" FontSize="14" Text="Dostępna zmienna: {imie}&#x0a;Wprowadzona wiadomość zostanie wysłana do wszystkich klientów w całej globalnej bazie danych aplikacji! (Tylko unikalne numery telefonu, ignorując duplikaty klientów)." />

                        <TextBox Text="{Binding MessageTemplate}" FontSize="18" Height="100" AcceptsReturn="True" TextWrapping="Wrap" />

                        <Button Command="{Binding PreviewBroadcastCommand}" Content="Rozpocznij Globalną Wysyłkę" Background="DodgerBlue" Foreground="White" FontSize="20" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10" Margin="0,10,0,0" />

                        <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="Bold" Foreground="Orange" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Confirmation Dialog Overlay -->
        <Border IsVisible="{Binding ShowConfirmationDialog}" Background="#90000000" ZIndex="10">
            <Border Padding="30" Background="#1E1E1E" BorderBrush="Gray" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="20">
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="Red" Text="OSTRZEŻENIE: Globalna Wysyłka SMS" HorizontalAlignment="Center" />
                    <TextBlock FontSize="20" Foreground="White" HorizontalAlignment="Center" Text="{Binding ClientsToReceiveSmsCount, StringFormat='Czy na pewno chcesz wysłać wiadomość UNIWERSALNĄ do \{0\} unikalnych numerów w KAŻDEJ BAZIE?'}" />
                    
                    <Grid ColumnDefinitions="*, *" Margin="0,15,0,0">
                        <Button Grid.Column="0" Content="Cofnij" Command="{Binding CancelBroadcastCommand}" Margin="0,0,10,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="20" Padding="10"/>
                        <Button Grid.Column="1" Content="Zatwierdź i Wyślij" Command="{Binding SendBroadcastCommand}" Background="DarkRed" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="20" Padding="10"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
