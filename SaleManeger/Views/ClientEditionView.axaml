<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:avedit="https://github.com/avaloniaui/avaloniaedit"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="SaleManeger.Views.ClientEditionView">

	<Grid Margin="10,30,10,10" RowDefinitions="Auto, Auto, *">
		<Grid Margin="5" ColumnDefinitions="Auto, *,*,Auto,Auto">
			<Button Margin="0,0,5,0" FontSize="25" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
					Content="Cofnij" Command="{Binding OpenClientSelectionCommand}" />
			<TextBox Grid.Column="1" FontSize="25" Text="{Binding	Name}" Watermark="Imie" />
			<TextBox Grid.Column="2" FontSize="25" Text="{Binding	Number}" Watermark="Numer Telefonu" />
            <!-- Pickup date/time pickers hidden from the GUI (not used by clients). Bindings and view model properties are kept; restore by uncommenting. Grid.Column 3 is Auto, so it collapses to zero width while empty.
            <Grid Grid.Column="3" ColumnDefinitions="Auto, Auto" Margin="5,0,0,0">
                <DatePicker Grid.Column="0" SelectedDate="{Binding ExpectedArrivalDate}" FontSize="25" VerticalAlignment="Stretch" MinHeight="0" />
                <TimePicker Grid.Column="1" SelectedTime="{Binding ExpectedArrivalTime}" Margin="5,0,0,0" FontSize="30" VerticalAlignment="Stretch" MinHeight="0" ClockIdentifier="24HourClock" />
            </Grid>
            -->
			<CheckBox Grid.Column="4" Margin="10,0,0,0" FontSize="20" VerticalAlignment="Center" IsChecked="{Binding AddToSmsGroup, Mode=TwoWay}" Content="Dodać do wysyłki SMS" />
		</Grid>
		
		<TextBlock Grid.Row="1" Text="{Binding WarningMessage}" Foreground="Red" FontSize="18" FontWeight="Bold" Margin="10,0,10,5" IsVisible="{Binding WarningMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
		
		<Grid Grid.Row="2" RowDefinitions="Auto, *, Auto" ColumnDefinitions="*,*,Auto">
            <TextBlock Grid.Column="0" Grid.Row="0" Margin="2,0,5,3" FontSize="16" FontWeight="SemiBold" Foreground="#FFC857"
                       Text="Zamówienie klienta (zarezerwowane)"
                       ToolTip.Tip="Produkty, które TEN klient zamówił. Zielona linia = już kupione, pomarańczowa = brakuje na stanie." />
            <TextBlock Grid.Column="1" Grid.Row="0" Margin="7,0,0,3" FontSize="16" FontWeight="SemiBold" Foreground="#7FD18B"
                       Text="Kupione przez klienta"
                       ToolTip.Tip="Produkty, które TEN klient faktycznie kupił (sprzedane)." />
            <Grid Grid.Column="0" Grid.Row="1" Grid.RowSpan="2" Margin="0,0,5,0">
                <avedit:TextEditor Name="order" FontSize="20" ShowLineNumbers="False" WordWrap="True" Background="Black" Foreground="White" BorderBrush="Gray" BorderThickness="2" Padding="5" />
                <TextBlock Name="orderWatermark" Text="Zamówienie" Foreground="DimGray" FontSize="20" Margin="7,7,0,0" IsHitTestVisible="False" />
            </Grid>
            <Grid Grid.Column="1" Grid.Row="1" Margin="5,0,0,5">
                <avedit:TextEditor Name="sale" FontSize="20" ShowLineNumbers="False" WordWrap="True" Background="Black" Foreground="White" BorderBrush="Gray" BorderThickness="2" Padding="5" />
                <TextBlock Name="saleWatermark" Text="Kupione" Foreground="DimGray" FontSize="20" Margin="7,7,0,0" IsHitTestVisible="False" />
            </Grid>
            <Grid Grid.Column="2" Grid.Row="0" Grid.RowSpan="3" RowDefinitions="Auto, Auto, *" Margin="5,0,0,0">
                <Button Content="{Binding DisplayModeText}" Command="{Binding ToggleDisplayModeCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,5" FontSize="20" FontWeight="SemiBold" Background="#2D2D30"/>
                <TextBlock Grid.Row="1" Margin="2,0,0,3" Text="{Binding CodesHeader}" FontSize="16" FontWeight="Bold" Foreground="{Binding CodesHeaderBrush}" ToolTip.Tip="{Binding CodesHint}" />
                <TextBox Grid.Row="2" Name="codes" IsReadOnly="True" UseFloatingWatermark="True" AcceptsReturn="True" Text="{Binding Codes}" Watermark="Kody" ToolTip.Tip="{Binding CodesHint}" />
            </Grid>
			<TextBox Grid.Column="1" Grid.Row="2" IsReadOnly="True" Name="saleSum"  FontSize="20" Text="{Binding SaleSum, Mode=TwoWay}" />
		</Grid>
	</Grid>
</UserControl>