<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SaleManeger.Views.SmsTestView">

    <Grid RowDefinitions="Auto, *, Auto" Margin="20">
        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,10" BorderBrush="Gray" BorderThickness="0,0,0,2" Padding="0,0,0,10">
            <Grid ColumnDefinitions="Auto, *">
                <Button Command="{Binding GoBackCommand}" Content="Cofnij" FontSize="20" Padding="15,5" />
                <TextBlock Grid.Column="1" Text="Bramka SMS - Test" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Spacing="15" Margin="0,15,0,0">
            <!-- Server Config -->
            <Border BorderBrush="#3D3D40" BorderThickness="1" CornerRadius="5" Padding="15" Background="#1E1E1E">
                <StackPanel Spacing="10">
                    <TextBlock Text="Konfiguracja Serwera (Capcom6 SMS Gateway)" FontWeight="SemiBold" FontSize="20" />
                    
                    <TextBlock Text="Adres API (Cloud: https://api.sms-gate.app/3rdparty/v1/message | WiFi: http://IP:8080/v1/message)" />
                    <TextBox Text="{Binding ApiUrl}" FontSize="18" />

                    <Grid ColumnDefinitions="*, *">
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Login (Basic Auth)" />
                            <TextBox Text="{Binding Login}" FontSize="18" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Hasło (Basic Auth)" />
                            <TextBox Text="{Binding Password}" FontSize="18" PasswordChar="*" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Test Message Form -->
            <Border BorderBrush="#3D3D40" BorderThickness="1" CornerRadius="5" Padding="15" Background="#1E1E1E">
                <StackPanel Spacing="10">
                    <TextBlock Text="Test Wiadomości" FontWeight="SemiBold" FontSize="20" />

                    <TextBlock Text="Numer Telefonu (z prefiksem np. +48)" />
                    <TextBox Text="{Binding PhoneNumber}" FontSize="18" Watermark="+48..." />

                    <TextBlock Text="Treść Wiadomości" />
                    <TextBox Text="{Binding MessageText}" FontSize="18" Height="100" AcceptsReturn="True" TextWrapping="Wrap" />

                    <Button Command="{Binding SendMessageCommand}" Content="Wyślij SMS" Background="DodgerBlue" Foreground="White" FontSize="20" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10" Margin="0,10,0,0" />

                    <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="Bold" Foreground="Orange" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
