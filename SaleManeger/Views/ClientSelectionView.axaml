<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:commands="clr-namespace:SaleManeger.ViewModels"
             x:Class="SaleManeger.Views.ClientSelectionView">

	<Grid RowDefinitions="Auto, *">
		<Grid Margin="10,30,10,10" MinHeight="50" Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
			<Button Margin="0,0,5,0" FontSize="25" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Grid.Column="0" Content="Cofnij" Command="{Binding	OpenProjectSelectionCommand}" />
			<Button FontSize="25" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Grid.Column="1" Content="Podsumowanie sprzedaży" Command="{Binding OpenSaleSummaryCommand}" />
			<TextBox Margin="5,0" FontSize="20" Name="clientName" Text="{Binding ClientName}" VerticalAlignment="Stretch" VerticalContentAlignment="Center"  Grid.Column="2" Watermark="Wprowadz imie, nazwisko lub numer telefonu" />
			<Button Name="filtr" FontSize="25" VerticalAlignment="Stretch" VerticalContentAlignment="Center"  Grid.Column="3" Content="Filtr">
				<Button.Flyout>
					<Flyout Placement="Bottom">
						<StackPanel Orientation="Vertical">
							<TextBox Text="{Binding ProductSearchText}" Watermark="Szukaj produktu..." Margin="0,0,0,5" FontSize="18" />
							<ScrollViewer MaxHeight="300">
								<ItemsControl Items="{Binding FilteredProducts}">
									<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Orientation="Vertical" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Margin="1">
											<CheckBox Command="{Binding	$parent[UserControl].DataContext.UpdateClientsCommand}" IsChecked="{Binding IsReserved,Mode=TwoWay}" Content="{Binding Name}"></CheckBox>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							</ScrollViewer>
							<Border BorderBrush="Gray" BorderThickness="0,3,0,0" Padding="2">
								<StackPanel Orientation="Vertical">
									<CheckBox Command="{Binding UpdateClientsCommand}" IsChecked="{Binding AreClientsWithOrderShowing}">Ma zamówienie</CheckBox>
									<CheckBox Command="{Binding UpdateClientsCommand}" IsChecked="{Binding AreClientsWithSaleShowing}">Ma kupno</CheckBox>
									<CheckBox Command="{Binding UpdateClientsCommand}" IsChecked="{Binding AreAllClientsShowing}">Pokarz wszystkich</CheckBox>
								</StackPanel>
							</Border>
							<Border BorderBrush="Gray" BorderThickness="0,3,0,0" Padding="2">
								<StackPanel Orientation="Vertical">
									<TextBlock FontSize="18" FontWeight="Bold" Text="Filtry zaawansowane (wszystkie muszą pasować)" />
									<ScrollViewer MaxHeight="250">
										<ItemsControl Items="{Binding AdvancedFilters}">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Border BorderBrush="Gray" BorderThickness="1" Margin="0,3" Padding="4">
														<StackPanel Orientation="Vertical">
															<StackPanel Orientation="Horizontal">
																<ComboBox Width="200" Items="{Binding $parent[UserControl].DataContext.FilterProducts}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}">
																	<ComboBox.ItemTemplate>
																		<DataTemplate>
																			<TextBlock Text="{Binding Name}" />
																		</DataTemplate>
																	</ComboBox.ItemTemplate>
																</ComboBox>
																<ComboBox Margin="5,0,0,0" Width="130" SelectedIndex="{Binding StatusIndex, Mode=TwoWay}">
																	<ComboBoxItem>Zamówione</ComboBoxItem>
																	<ComboBoxItem>Kupione</ComboBoxItem>
																	<ComboBoxItem>Zamówione lub kupione</ComboBoxItem>
																</ComboBox>
																<Button Margin="5,0,0,0" Content="Usuń" Command="{Binding $parent[UserControl].DataContext.RemoveFilterCommand}" CommandParameter="{Binding}" />
															</StackPanel>
															<StackPanel Orientation="Horizontal" Margin="0,3,0,0">
																<ComboBox Width="130" SelectedIndex="{Binding MetricIndex, Mode=TwoWay}">
																	<ComboBoxItem>Ilość (kg)</ComboBoxItem>
																	<ComboBoxItem>Wartość (zł)</ComboBoxItem>
																</ComboBox>
																<ComboBox Margin="5,0,0,0" Width="150" SelectedIndex="{Binding AggregationIndex, Mode=TwoWay}">
																	<ComboBoxItem>Suma</ComboBoxItem>
																	<ComboBoxItem>Pojedyncze zamówienie</ComboBoxItem>
																</ComboBox>
																<ComboBox Margin="5,0,0,0" Width="100" SelectedIndex="{Binding ComparisonIndex, Mode=TwoWay}">
																	<ComboBoxItem>powyżej</ComboBoxItem>
																	<ComboBoxItem>poniżej</ComboBoxItem>
																</ComboBox>
																<TextBox Margin="5,0,0,0" Width="80" Text="{Binding ThresholdText, Mode=TwoWay}" Watermark="np. 50" />
															</StackPanel>
														</StackPanel>
													</Border>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</ScrollViewer>
									<Button Margin="0,3,0,0" Command="{Binding AddFilterCommand}" Content="+ Dodaj filtr" />
								</StackPanel>
							</Border>
						</StackPanel>
					</Flyout>
				</Button.Flyout>
			</Button>
			<Button Margin="5,0" FontSize="25"  VerticalAlignment="Stretch" VerticalContentAlignment="Center"  Grid.Column="4" Content="Add client" Command="{Binding $parent[UserControl].DataContext.OpenClientEditionCommand}" CommandParameter="{Binding	#clientName.Text}" />
			<Button Margin="5,0" FontSize="25"  VerticalAlignment="Stretch" VerticalContentAlignment="Center"  Grid.Column="5" Content="Więcej" Command="{Binding $parent[UserControl].DataContext.OpenMoreSettingsCommand}">
			</Button>
		</Grid>

		<Border BorderBrush="Gray" Margin="10,0,10,10" Grid.Row="1" BorderThickness="2">
			<ScrollViewer>
				<ItemsRepeater Items="{Binding Clients,Mode=TwoWay}" Name="clients">
					<ItemsRepeater.Layout>
						<StackLayout Orientation="Vertical" />
					</ItemsRepeater.Layout>
					<ItemsRepeater.ItemTemplate>
						<DataTemplate>
							<Grid Margin="5" ColumnDefinitions="Auto,100*,Auto,Auto,Auto">
								<TextBlock Grid.Column="0" Foreground ="{Binding Color}" FontSize="40" Text="{Binding Name}" />
								<TextBlock Grid.Column="1" Foreground ="{Binding Color}" Margin ="10,0,0,0" FontSize="40" Text="{Binding PhoneNumber}" />
								<TextBlock Grid.Column="2" Foreground ="{Binding Color}" Margin ="20,0,20,0" FontSize="30" VerticalAlignment="Center" Text="{Binding ExpectedArrivalTime, StringFormat=\{0:dd.MM HH:mm\}}" />
								<Button HorizontalAlignment="Right" Grid.Column="3" Command="{Binding $parent[UserControl].DataContext.OpenClientEditionCommand}" CommandParameter="{Binding ID}" HorizontalContentAlignment="Center" Width="80" FontSize="20" Content="Open" />
								<Button HorizontalAlignment="Right" Grid.Column="4" Command="{Binding $parent[UserControl].DataContext.DeleteClientCommand}" Margin="10,0,0,0" CommandParameter="{Binding ID}" HorizontalContentAlignment="Center" Width="80" FontSize="20" Content="Delete" />
							</Grid>
						</DataTemplate>
					</ItemsRepeater.ItemTemplate>
				</ItemsRepeater>
			</ScrollViewer>
		</Border>
	</Grid>
</UserControl>