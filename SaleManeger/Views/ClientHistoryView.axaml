<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="SaleManeger.Views.ClientHistoryView">
	<Grid Margin="10,30,10,10" RowDefinitions="Auto,Auto,*">
		<Grid ColumnDefinitions="Auto,*">
			<Button FontSize="25" Content="Cofnij" Command="{Binding ReturnCommand}" VerticalAlignment="Stretch" VerticalContentAlignment="Center" />
			<StackPanel Grid.Column="1" Margin="15,0,0,0" Orientation="Vertical">
				<StackPanel Orientation="Horizontal" Spacing="20">
					<TextBlock FontSize="36" FontWeight="Bold" Text="{Binding ClientName}" />
					<TextBlock FontSize="28" VerticalAlignment="Bottom" Foreground="Gray" Text="{Binding PhoneNumber}" />
				</StackPanel>
				<TextBlock IsVisible="{Binding HasTags}" FontSize="16" Foreground="Orange" Text="{Binding Tags}" />
				<TextBlock IsVisible="{Binding HasNotes}" FontSize="16" Foreground="Gray" TextWrapping="Wrap" Text="{Binding Notes}" />
			</StackPanel>
		</Grid>

		<TextBlock Grid.Row="1" IsVisible="{Binding !HasHistory}" Margin="5,25" FontSize="22" Foreground="Gray" TextWrapping="Wrap"
		           Text="Ten klient nie ma jeszcze żadnego zamówienia ani zakupu. Historia pojawi się, gdy zapiszesz pierwsze zamówienie." />

		<UniformGrid Grid.Row="1" Rows="1" Margin="0,15,0,10" IsVisible="{Binding HasHistory}">
			<Border Margin="0,0,5,0" Padding="10" Background="#2D2D30" CornerRadius="5">
				<StackPanel>
					<TextBlock FontSize="14" Foreground="Gray" Text="Odebrane sprzedaże" />
					<TextBlock FontSize="28" FontWeight="Bold" Text="{Binding VisitsText}" />
				</StackPanel>
			</Border>
			<Border Margin="5,0" Padding="10" Background="#2D2D30" CornerRadius="5">
				<StackPanel>
					<TextBlock FontSize="14" Foreground="Gray" Text="Wydane razem" />
					<TextBlock FontSize="28" FontWeight="Bold" Foreground="LightGreen" Text="{Binding TotalSpentText}" />
				</StackPanel>
			</Border>
			<Border Margin="5,0" Padding="10" Background="#2D2D30" CornerRadius="5">
				<StackPanel>
					<TextBlock FontSize="14" Foreground="Gray" Text="Średnio na sprzedaż" />
					<TextBlock FontSize="28" FontWeight="Bold" Text="{Binding AverageSpentText}" />
				</StackPanel>
			</Border>
			<Border Margin="5,0" Padding="10" Background="#2D2D30" CornerRadius="5">
				<StackPanel>
					<TextBlock FontSize="14" Foreground="Gray" Text="Ostatni zakup" />
					<TextBlock FontSize="28" FontWeight="Bold" Text="{Binding LastVisitText}" />
				</StackPanel>
			</Border>
			<Border Margin="5,0,0,0" Padding="10" Background="#2D2D30" CornerRadius="5" ToolTip.Tip="Sprzedaże, w których klient zamówił, ale nic nie kupił (bez trwającej sprzedaży).">
				<StackPanel>
					<TextBlock FontSize="14" Foreground="Gray" Text="Nie odebrał" />
					<TextBlock FontSize="28" FontWeight="Bold" Foreground="IndianRed" Text="{Binding MissedText}" />
				</StackPanel>
			</Border>
		</UniformGrid>

		<Grid Grid.Row="2" ColumnDefinitions="3*,2*" IsVisible="{Binding HasHistory}">
			<Border BorderBrush="Gray" BorderThickness="2" Margin="0,0,5,0">
				<Grid RowDefinitions="Auto,*">
					<Grid Margin="8,6" ColumnDefinitions="2*,*,2*,*,*">
						<TextBlock FontWeight="Bold" FontSize="16" Text="Sprzedaż" />
						<TextBlock Grid.Column="1" FontWeight="Bold" FontSize="16" Text="Data" />
						<TextBlock Grid.Column="2" FontWeight="Bold" FontSize="16" Text="Zamówione" />
						<TextBlock Grid.Column="3" FontWeight="Bold" FontSize="16" Text="Kupione" />
						<TextBlock Grid.Column="4" FontWeight="Bold" FontSize="16" Text="Status" />
					</Grid>
					<ScrollViewer Grid.Row="1">
						<ItemsControl Items="{Binding Sales}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Grid Margin="8,4" ColumnDefinitions="2*,*,2*,*,*">
										<TextBlock FontSize="18" TextWrapping="Wrap" Text="{Binding SaleName}" />
										<TextBlock Grid.Column="1" FontSize="16" Foreground="Gray" Text="{Binding DateText}" />
										<TextBlock Grid.Column="2" FontSize="16" TextWrapping="Wrap" Text="{Binding OrderedText}" />
										<TextBlock Grid.Column="3" FontSize="16" Text="{Binding BoughtText}" />
										<TextBlock Grid.Column="4" FontSize="16" Foreground="{Binding StatusBrush}" Text="{Binding Status}" />
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Grid>
			</Border>
			<Border Grid.Column="1" BorderBrush="Gray" BorderThickness="2" Margin="5,0,0,0">
				<Grid RowDefinitions="Auto,*">
					<Grid Margin="8,6" ColumnDefinitions="2*,Auto,*,*">
						<TextBlock FontWeight="Bold" FontSize="16" Text="Ulubione produkty" />
						<TextBlock Grid.Column="1" FontWeight="Bold" FontSize="16" Margin="0,0,10,0" Text="Razy" />
						<TextBlock Grid.Column="2" FontWeight="Bold" FontSize="16" Text="Zamówił" />
						<TextBlock Grid.Column="3" FontWeight="Bold" FontSize="16" Text="Wydał" />
					</Grid>
					<ScrollViewer Grid.Row="1">
						<ItemsControl Items="{Binding FavouriteProducts}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Grid Margin="8,4" ColumnDefinitions="2*,Auto,*,*">
										<TextBlock FontSize="18" TextWrapping="Wrap" Text="{Binding Name}" />
										<TextBlock Grid.Column="1" FontSize="16" Margin="0,0,10,0" Text="{Binding SalesText}" />
										<TextBlock Grid.Column="2" FontSize="16" Text="{Binding OrderedText}" />
										<TextBlock Grid.Column="3" FontSize="16" Text="{Binding SpentText}" />
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</UserControl>
